/*
LeetCode: Max Consecutive Ones
Approach: Iteration
Time Complexity: O(n)
Space Complexity: O(1)
*/

class Solution {
public:
    int findMaxConsecutiveOnes(vector<int>& nums) {
        int count = 0;
        int max_count = 0;
        for (int i = 0; i < nums.size(); i++) {
            if (nums.at(i) == 1) {
                count++; 
                if (count > max_count) {
                    max_count = count;
                }
            }
            else {
                count = 0;
            }
        }
        return max_count;
    }
};